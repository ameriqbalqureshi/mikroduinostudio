{
  "projectName": "SevenSegShift Hello Shift Basics",
  "version": "1.0.0",
  "target": {
    "mcu": "ATmega328P",
    "clock": 16000000
  },
  "programmer": {
    "type": "ARDUINO",
    "port": "COM3",
    "baudRate": 115200
  },
  "build": {
    "optimization": "O2",
    "warnings": "all",
    "cppStandard": "c++17",
    "includeDirs": [
      "../../../../sdk/modules/SevenSegShift/include"
    ],
    "extraSources": [
      "../../../../sdk/modules/SevenSegShift/src/SevenSegShift.cpp"
    ]
  },
  "sourceFiles": [
    "src/main.cpp"
  ]
}
