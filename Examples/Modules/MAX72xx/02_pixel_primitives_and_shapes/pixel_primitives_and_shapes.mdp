{
  "projectName": "MAX72xx Pixel Primitives and Shapes",
  "version": "1.0.0",
  "target": {
    "mcu": "ATmega328P",
    "clock": 16000000
  },
  "programmer": {
    "type": "ARDUINO",
    "port": "COM3",
    "baudRate": 115200
  },
  "build": {
    "optimization": "O2",
    "warnings": "all",
    "cppStandard": "c++17",
    "includeDirs": [
      "../../../../sdk/modules/MAX72xx/include"
    ]
  },
  "sourceFiles": [
    "src/main.cpp",
    "../../../../sdk/modules/MAX72xx/src/MAX72xx.cpp"
  ]
}
